---
import Simulator from './Simulator.astro'
import {DEFAULT_LOCALE, LOCALES, localePath, site, type Locale} from '../i18n'
import '../styles/global.css'

const {lang} = Astro.props as {lang: Locale}
const copy = site(lang)
const repo = 'https://github.com/jagenaujagenau/ground-truth'

const features = [
  {icon: 'M4 18V9M10 18V5M16 18v-6M20.5 18h-17', title: copy.feature1Title, body: copy.feature1Body},
  {
    icon: 'M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1',
    title: copy.feature2Title,
    body: copy.feature2Body
  },
  {
    icon: 'M12 8.5v4.5M12 16.5v.01M10.3 4l-7.6 13.2A2 2 0 0 0 4.4 20h15.2a2 2 0 0 0 1.7-2.8L13.7 4a2 2 0 0 0-3.4 0z',
    title: copy.feature3Title,
    body: copy.feature3Body
  },
  {icon: 'M7 17L17 7M9 7h8v8', title: copy.feature4Title, body: copy.feature4Body}
]
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
    <title>{copy.metaTitle}</title>
    <meta name="description" content={copy.metaDescription} />
    <meta property="og:title" content="Ground Truth" />
    <meta property="og:description" content={copy.metaDescription} />
    <meta property="og:locale" content={lang} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l.code} href={new URL(localePath(l.code), Astro.site ?? Astro.url).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(DEFAULT_LOCALE), Astro.site ?? Astro.url).href}
    />
  </head>

  <body>
    <header class="site-head" id="site-head">
      <div class="wrap">
        <a class="brand" href={localePath(lang)}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="8" class="mark-tile"></rect>
            <rect x="7" y="14" width="5" height="11" rx="1.5" class="mark-l"></rect>
            <rect x="13.5" y="7" width="5" height="18" rx="1.5" class="mark-c"></rect>
            <rect x="20" y="11" width="5" height="14" rx="1.5" class="mark-r"></rect>
          </svg>
          Ground Truth
        </a>
        <nav class="site-nav">
          <a href="#demo" class="nav-hide">{copy.navDemo}</a>
          <label class="lang" aria-label={copy.languageLabel}>
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zM3.7 12h16.6M12 3.5c2.2 2.3 3.3 5 3.3 8.5s-1.1 6.2-3.3 8.5c-2.2-2.3-3.3-5-3.3-8.5S9.8 5.8 12 3.5z"
              ></path></svg
            >
            <select data-lang-switch>
              {
                LOCALES.map((l) => (
                  <option value={localePath(l.code)} selected={l.code === lang}>
                    {l.name}
                  </option>
                ))
              }
            </select>
          </label>
          <a class="btn btn-ghost btn-sm" href={repo}>{copy.navGet}</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap">
          <p class="tagline">
            <svg viewBox="0 0 32 32" width="18" height="18" aria-hidden="true">
              <rect width="32" height="32" rx="8" class="mark-tile"></rect>
              <rect x="7" y="14" width="5" height="11" rx="1.5" class="mark-l"></rect>
              <rect x="13.5" y="7" width="5" height="18" rx="1.5" class="mark-c"></rect>
              <rect x="20" y="11" width="5" height="14" rx="1.5" class="mark-r"></rect>
            </svg>
            {copy.tagline}
          </p>
          <h1>{copy.heroTitle}</h1>
          <p>{copy.heroLede}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={repo}>
              <svg viewBox="0 0 24 24"><path d="M12 3.5v13M7 11.5l5 5 5-5M4.5 20.5h15"></path></svg>
              {copy.heroAdd}
            </a>
            <a class="btn btn-ghost" href="#demo">
              <svg viewBox="0 0 24 24"><path d="M9 7.5l8 4.5-8 4.5z"></path></svg>
              {copy.heroDemo}
            </a>
          </div>
        </div>
      </section>

      <section class="section demo" id="demo">
        <div class="wrap">
          <Simulator lang={lang} />
        </div>
      </section>

      <section class="section" id="features">
        <div class="wrap">
          <div class="section-head center">
            <h2>{copy.featuresTitle}</h2>
            <p>{copy.featuresLede}</p>
          </div>
          <div class="grid">
            {
              features.map((f) => (
                <article class="tile">
                  <span class="tile-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={f.icon} /></svg>
                  </span>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="privacy">
        <div class="wrap">
          <div class="band">
            <h2>{copy.bandTitle}</h2>
            <p class="band-lede">{copy.bandLede}</p>
            <a class="btn btn-invert" href={repo}>{copy.bandCta}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <p>{copy.footerLine}</p>
        <nav class="foot-links">
          <a href={repo}>GitHub</a>
          <a href={`${repo}/blob/main/PRIVACY.md`}>{copy.footerPrivacy}</a>
        </nav>
      </div>
    </footer>

    <script>
      const head = document.getElementById('site-head')!
      const onScroll = () => (head.dataset.stuck = String(window.scrollY > 8))
      onScroll()
      addEventListener('scroll', onScroll, {passive: true})

      // The switcher is a plain <select> so it works before any of this runs.
      document.querySelector<HTMLSelectElement>('[data-lang-switch]')?.addEventListener('change', (e) => {
        const to = (e.target as HTMLSelectElement).value
        location.href = `${to}${location.hash}`
      })
    </script>
  </body>
</html>
