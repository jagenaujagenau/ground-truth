---
// The same four ways to chip in as tktk.lol, in a plain <dialog> rather than a React modal.
import {site, type Locale} from '../i18n'

const {lang} = Astro.props as {lang: Locale}
const copy = site(lang)

const WAYS = [
  {
    name: 'Patreon',
    note: copy.supportMonthly,
    url: 'https://dub.sh/diego-petreon',
    fill: '#FF424D',
    path: 'M15.386 0c-4.764 0-8.642 3.878-8.642 8.642 0 4.764 3.878 8.642 8.642 8.642 4.764 0 8.642-3.878 8.642-8.642C24.028 3.878 20.15 0 15.386 0zM.012 23.97h4.234V0H.012v23.97z'
  },
  {
    name: 'Buy Me a Coffee',
    note: copy.supportOnce,
    url: 'https://dub.sh/support-diego',
    fill: '#FFDD00',
    path: 'M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-1.001-1.379-.197-.069-.42-.098-.57-.241-.152-.143-.196-.366-.231-.572-.065-.378-.125-.756-.192-1.133-.057-.325-.102-.69-.25-.987-.195-.4-.597-.634-.996-.788a5.723 5.723 0 00-.626-.194c-1-.263-2.05-.36-3.077-.416a25.834 25.834 0 00-3.7.062c-.915.083-1.88.184-2.75.5-.318.116-.646.256-.888.501-.297.302-.393.77-.177 1.146.154.267.415.456.692.58.36.162.737.284 1.123.366 1.075.238 2.189.331 3.287.37 1.218.05 2.437.01 3.65-.118.299-.033.598-.073.896-.119.352-.054.578-.513.474-.834-.124-.383-.457-.531-.834-.473-.466.074-.96.108-1.382.146-1.177.08-2.358.082-3.536.006a22.228 22.228 0 01-1.157-.107c-.086-.01-.18-.025-.258-.036-.243-.036-.484-.08-.724-.13-.111-.027-.111-.185 0-.212h.005c.277-.06.557-.108.838-.147h.002c.131-.009.263-.032.394-.048a25.076 25.076 0 013.426-.12c.674.019 1.347.067 2.017.144l.228.031c.267.04.533.088.798.145.392.085.895.113 1.07.542.055.137.08.288.111.431l.319 1.484a.237.237 0 01-.199.284h-.003c-.037.006-.075.01-.112.015a36.704 36.704 0 01-4.743.295 37.059 37.059 0 01-4.699-.304c-.14-.017-.293-.042-.417-.06-.326-.048-.649-.108-.973-.161-.393-.065-.768-.032-1.123.161-.29.16-.527.404-.675.701-.154.316-.199.66-.267 1-.069.34-.176.707-.135 1.056.087.753.613 1.365 1.37 1.502a39.69 39.69 0 0011.343.376.483.483 0 01.535.53l-.071.697-1.018 9.907c-.041.41-.047.832-.125 1.237-.122.637-.553 1.028-1.182 1.171-.577.131-1.165.2-1.756.205-.656.004-1.31-.025-1.966-.022-.699.004-1.556-.06-2.095-.58-.475-.458-.54-1.174-.605-1.793l-.731-7.013-.322-3.094c-.037-.351-.286-.695-.678-.678-.336.015-.718.3-.678.679l.228 2.185.949 9.112c.147 1.344 1.174 2.068 2.446 2.272.742.12 1.503.144 2.257.156.966.016 1.942.053 2.892-.122 1.408-.258 2.465-1.198 2.616-2.657.34-3.332.683-6.663 1.024-9.995l.215-2.087a.484.484 0 01.39-.426c.402-.078.787-.212 1.074-.518.455-.488.546-1.124.385-1.766z'
  },
  {
    name: 'PayPal',
    note: copy.supportDirect,
    url: 'https://dub.sh/diego-paypal',
    fill: '#00457C',
    path: 'M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19c-.524 0-.968.382-1.05.9l-1.12 7.106zm14.146-14.42a3.35 3.35 0 0 0-.607-.541c-.013.076-.026.175-.041.254-.93 4.778-4.005 7.201-9.138 7.201h-2.19a.563.563 0 0 0-.556.479l-1.187 7.527h-.506l-.24 1.516a.56.56 0 0 0 .554.647h3.882c.46 0 .85-.334.922-.788.06-.26.76-4.852.816-5.09a.932.932 0 0 1 .923-.788h.58c3.76 0 6.705-1.528 7.565-5.946.36-1.847.174-3.388-.777-4.471z'
  },
  {
    name: 'Bitcoin',
    note: copy.supportCrypto,
    address: 'bc1qwhrcznvy74hmnhjk9zjrq3hlhglc6xd9w37egq',
    fill: '#F7931A',
    path: 'M23.638 14.904c-1.602 6.43-8.113 10.34-14.542 8.736C2.67 22.05-1.244 15.525.362 9.105 1.962 2.67 8.475-1.243 14.9.358c6.43 1.605 10.342 8.115 8.738 14.548v-.002zm-6.35-4.613c.24-1.59-.974-2.45-2.64-3.03l.54-2.153-1.315-.33-.525 2.107c-.345-.087-.705-.167-1.064-.25l.526-2.127-1.32-.33-.54 2.165c-.285-.067-.565-.132-.84-.2l-1.815-.45-.35 1.407s.975.225.955.236c.535.136.63.486.615.766l-1.477 5.92c-.075.166-.24.406-.614.314.015.02-.96-.24-.96-.24l-.66 1.51 1.71.426.93.242-.54 2.19 1.32.327.545-2.19c2.24.427 3.93.257 4.64-1.774.57-1.637-.03-2.58-1.217-3.196.854-.193 1.5-.76 1.68-1.93h.01zm-3.01 4.22c-.404 1.64-3.157.75-4.05.53l.72-2.9c.896.23 3.757.67 3.33 2.37zm.41-4.24c-.37 1.49-2.662.735-3.405.55l.654-2.64c.744.18 3.137.524 2.75 2.084v.006z'
  }
]
---

<button class="support-open" type="button" data-support-open>
  <svg viewBox="0 0 24 24" aria-hidden="true"
    ><path
      d="M12 20.5C10.5 19.2 3.5 14.8 3.5 9.7A4.2 4.2 0 0 1 12 7.6a4.2 4.2 0 0 1 8.5 2.1c0 5.1-7 9.5-8.5 10.8z"
    ></path></svg
  >
  {copy.supportCta}
</button>

<dialog class="support" data-support>
  <form method="dialog" class="support-close-form">
    <button class="support-close" aria-label={copy.supportClose}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"></path></svg>
    </button>
  </form>

  <h2>{copy.supportTitle}</h2>
  <p class="support-lede">{copy.supportBody}</p>

  <ul class="support-ways">
    {
      WAYS.map((way) => (
        <li class="support-way">
          <svg class="support-logo" viewBox="0 0 24 24" aria-hidden="true" style={`fill:${way.fill}`}>
            <path d={way.path} />
          </svg>
          <span class="support-name">
            <b>{way.name}</b>
            <small>{way.note}</small>
          </span>
          {way.address ? (
            <button
              class="support-action"
              type="button"
              data-copy={way.address}
              data-copied={copy.supportCopied}
            >
              {copy.supportCopy}
            </button>
          ) : (
            <a class="support-action" href={way.url} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
            </a>
          )}
        </li>
      ))
    }
  </ul>

  <p class="support-thanks">{copy.supportThanks}</p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-support]')
  document
    .querySelector<HTMLButtonElement>('[data-support-open]')
    ?.addEventListener('click', () => dialog?.showModal())

  // Clicking the backdrop closes it: the dialog's own box is the only thing inside it.
  dialog?.addEventListener('click', (e) => {
    const box = dialog.getBoundingClientRect()
    const outside =
      e.clientX < box.left || e.clientX > box.right || e.clientY < box.top || e.clientY > box.bottom
    if (outside) dialog.close()
  })

  dialog?.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.textContent
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!)
        button.textContent = button.dataset.copied!
        button.classList.add('is-copied')
        setTimeout(() => {
          button.textContent = label
          button.classList.remove('is-copied')
        }, 2000)
      } catch {
        // Clipboard refused (no permission, insecure context): show the address to copy by hand.
        button.replaceWith(Object.assign(document.createElement('code'), {textContent: button.dataset.copy}))
      }
    })
  })
</script>

<style>
  .support-open {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-3);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
    transition: color 0.15s;
  }
  .support-open:hover {
    color: var(--ink);
  }
  .support-open svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linejoin: round;
  }
  .support-open:hover svg {
    fill: var(--right);
    stroke: var(--right);
  }

  .support {
    width: min(420px, calc(100vw - 32px));
    padding: 26px;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 40px 80px -40px rgba(22, 24, 29, 0.6);
  }
  .support::backdrop {
    background: rgba(22, 24, 29, 0.42);
    backdrop-filter: blur(3px);
  }
  .support[open] {
    animation: support-in 0.22s var(--ease);
  }
  @keyframes support-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }

  .support-close-form {
    float: right;
    margin: -6px -6px 0 0;
  }
  .support-close {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .support-close:hover {
    background: var(--sunk);
    color: var(--ink);
  }
  .support-close svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .support h2 {
    font: 600 22px/1.2 var(--serif);
    letter-spacing: -0.015em;
  }
  .support-lede {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .support-ways {
    display: grid;
    gap: 2px;
    margin-top: 20px;
  }
  .support-way {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    transition: border-color 0.15s, background 0.15s;
  }
  .support-way:hover {
    border-color: var(--line-strong);
    background: var(--paper);
  }
  .support-logo {
    width: 22px;
    height: 22px;
    flex: none;
  }
  .support-name {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .support-name b {
    font-size: 14px;
    font-weight: 600;
  }
  .support-name small {
    font-size: 12px;
    color: var(--ink-3);
  }

  .support-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: 9px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 12.5px;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .support-action:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .support-action.is-copied {
    border-color: var(--ok, #1f8a5b);
    color: var(--ok, #1f8a5b);
    background: transparent;
  }
  .support-action svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .support code {
    font: 11px/1.4 ui-monospace, 'SF Mono', Menlo, monospace;
    overflow-wrap: anywhere;
  }

  .support-thanks {
    margin-top: 18px;
    font-size: 12.5px;
    color: var(--ink-3);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .support[open] {
      animation: none;
    }
  }
</style>
