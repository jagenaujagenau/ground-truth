# The key the site reads articles with. It stays on the server: the browser only ever talks to
# /api/analyze. The extension's own EXTENSION_PUBLIC_TYPESAFE_API_KEY is accepted too.
TYPESAFE_API_KEY=

# How many articles the whole site will read in a day, before it starts turning people away.
DAILY_READ_LIMIT=400

# Where the cache, the rate limit and the daily count are kept, shared by every function instance:
# an Upstash Redis REST endpoint (Vercel's KV/Upstash integration sets both). Left empty, each
# instance keeps its own in memory, which is fine for local dev but lets the cap drift in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
